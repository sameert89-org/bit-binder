.git
.github
.tmp
**/.obsidian
**/.trash

# Existing local exports must never enter the build context. Docker regenerates
# these in isolated stages. Explicitly allow only the hand-written landing-page
# files and assets; this remains independent of vault names.
server/public/**
!server/public/index.html
!server/public/favicon.ico
!server/public/cat.gif
!server/public/app/
!server/public/app/**

server/main
server/main.exe
*.log
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
