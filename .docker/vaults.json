{
  "indexFile": "index.md",
  "exclude": [
    "Archived/*"
  ],
  "siteNames": {},
  "vaultSettings": {
    "Data Structures & Algorithms": {
      "theme": "Blue Topaz",
      "snippets": [
        "custom"
      ],
      "plugins": [
        "obsidian-excalidraw-plugin",
        "highlightr-plugin"
      ],
      "pluginData": {
        "obsidian-excalidraw-plugin": {
          "displaySVGInPreview": true,
          "previewImageType": "SVG",
          "displayExportedImageIfAvailable": true,
          "autoexportSVG": true
